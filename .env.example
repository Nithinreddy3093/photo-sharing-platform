# ==============================================================================
# VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CONFIGURATION (Safe for browser / Vite build)
# ------------------------------------------------------------------------------
# Note: The client uses firebase-applet-config.json by default.
# The following variables can optionally override them:
# VITE_FIREBASE_PROJECT_ID="gen-lang-client-0384551552"
# VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0384551552.firebasestorage.app"
# VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-photosharingplat-d9da5e98-9d48-42be-9ea8-09439abc7683"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (VERCEL ENVIRONMENT VARIABLES - NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
# Firebase Admin Project & Storage configuration
FIREBASE_PROJECT_ID=gen-lang-client-0384551552
FIREBASE_STORAGE_BUCKET=gen-lang-client-0384551552.firebasestorage.app

# Firebase Admin Service Account Credentials (Optional on GCP, required on Vercel for privileged operations)
# Option A: Paste full service account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"gen-lang-client-0384551552",...}
# Option B: Individual fields
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@gen-lang-client-0384551552.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Secret key used for signing customer gallery temporary session tokens and photo stream signatures
JWT_SECRET=production-secret-jwt-key-change-this-in-production

# App hosting URL
APP_URL="https://your-app-name.vercel.app"

