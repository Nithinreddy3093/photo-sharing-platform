# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Project Configuration
# Single backend for Authentication, Cloud Firestore, and Firebase Storage
FIREBASE_PROJECT_ID=gen-lang-client-0384551552
FIREBASE_STORAGE_BUCKET=gen-lang-client-0384551552.firebasestorage.app

# Secret key used for signing customer gallery temporary JWT session tokens
JWT_SECRET=super-secret-jwt-key-change-this-in-production
